# ============================================================
# 古韵AI 项目 .gitignore
# 目标：仓库只存源码与文档，绝不存依赖、构建产物、密钥与生成文件
# ============================================================

# ---------- Node 依赖 ----------
node_modules/
frontend/node_modules/
.npm/
.pnpm-store/

# ---------- 构建产物 ----------
frontend/dist/
dist/
dist-backend/
# release* 覆盖 release/、release-v234/、release-new/ 等所有打包输出目录，
# 避免误将上百 MB 的安装包提交入库
release*/
release-*/
build/
*.tsbuildinfo

# ---------- 本地运行时残留的旧发布包 ----------
# 说明：以下目录在本机当前被某个进程锁住了 app.asar 文件（WinError 32），
# 进程级占用未释放之前普通用户态无法删除；.gitignore 已覆盖，git 不会上传。
# 待重启后请手动执行：rd /s /q "release"  "release-new"  "release-v234"
# 若仍提示占用，资源管理器中关闭项目根目录的打开句柄后再试。
release/win-unpacked/
release-new/win-unpacked/
release-v234/win-unpacked/

# ---------- 临时构建目录（electron-builder 中间文件） ----------
.tmp-build/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
backend/*.db
backend/*.db-journal
*.sqlite3
.pytest_cache/
.ruff_cache/

# ---------- PyInstaller ----------
*.spec.bak
backend/build/
backend/dist/

# ---------- 环境变量与密钥（绝不入库） ----------
.env
.env.*
!.env.example
*.key
*.pem

# ---------- 生成产物（MIDI / 音频 / 乐谱导出） ----------
backend/output/*.mid
backend/output/*.wav
backend/output/*.mp3
backend/output/*.lrc
backend/output/*.pdf
backend/output/*.musicxml
backend/output/*.mxl
!backend/output/.gitkeep

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
*.log
logs/

# ---------- 大模型权重与音色库（体积过大，本地自持不入库） ----------
models/
*.sf2
*.sf3
*.sfz
*.ckpt
*.safetensors
*.onnx

# ---------- 运行时密钥文件（设置面板持久化） ----------
backend/app/.secrets.json
build-py/
exe_test*.log

# ---------- IDE / 工具工作目录（个人过程记录与 IDE 状态，绝不入库） ----------
.trae/
.workbuddy/
.cursor/
.aider*
.claude/
.mavis/